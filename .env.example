# Copy to .env and fill in your key:  cp .env.example .env
#
# .env is gitignored; this file is the documented contract for what the app can
# be configured with. NEVER put a real key in this file.

# =============================================================================
# REQUIRED — you only need a key for the provider named in DEFAULT_PROVIDER
# =============================================================================
# Switching providers is purely an env var change; no code edit is needed.
DEFAULT_PROVIDER=gemini      # gemini | anthropic | openai | ollama

# Gemini is the default: the most generous free tier of the three hosted
# providers. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest

# Anthropic — set DEFAULT_PROVIDER=anthropic to use this instead.
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================================
# LLM behaviour
# =============================================================================
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Verify credentials at startup with one free, non-generative API call.
# Set to false for offline development (the app then boots without checking,
# and a bad key surfaces on the first request instead).
VALIDATE_PROVIDER_ON_STARTUP=true

# ---- Other providers (optional) ---------------------------------------------
# Only needed if you set DEFAULT_PROVIDER to these, or pass
# {"provider": "..."} in a request body to override per request.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                       # for OpenAI-compatible gateways
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# =============================================================================
# App
# =============================================================================
APP_NAME=docXpo
ENVIRONMENT=local            # local | dev | prod
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false               # true in deployed environments

# ---- Postgres ---------------------------------------------------------------
# Use localhost when running the app on the host against compose's exposed port.
# docker-compose overrides POSTGRES_HOST to "postgres" for the app container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docxpo
POSTGRES_PASSWORD=docxpo
POSTGRES_DB=docxpo
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- Rate limiting / API keys -----------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60            # sustained rate; bucket refills at rpm/60 per second
RATE_LIMIT_BURST=20          # how large a burst an idle client may spend at once
RATE_LIMIT_FAIL_OPEN=true    # if Redis is down: true = allow, false = reject

# Comma-separated. EMPTY = no authentication: the service runs open and meters
# by client IP, which keeps local dev and the browser console working. Setting
# any key switches on enforcement (401 without a valid X-API-Key).
API_KEYS=

# ---- API --------------------------------------------------------------------
API_V1_PREFIX=/v1
CORS_ORIGINS=["*"]

# ---- Observability ----------------------------------------------------------
METRICS_ENABLED=true
# JSON overrides for the pricebook, e.g.
#   PRICING_OVERRIDES={"gemini-3.6-flash": {"input": 0.30, "output": 2.50}}
PRICING_OVERRIDES=
